# Paperless-ngx
PAPERLESS_URL=http://webserver:8000
PAPERLESS_TOKEN=replace-with-a-paperless-api-token
PAPERLESS_DOCKER_NETWORK=paperless_default

# Shared local OpenAI-compatible endpoint
CLERK_OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# CLERK_OPENAI_API_KEY=

# Vision/OCR model
CLERK_OCR_MODEL=qwen2.5vl:7b
# Request contract: generic, deepseek_ocr, or deepseek_ocr_llamacpp.
# deepseek_ocr targets the native model served by vLLM and is guarded,
# review-only OCR because that model requires content-changing loop prevention.
# The llama.cpp profile reproduces the earlier DeepSeek-OCR-2 GGUF request
# contract and remains experimental.
# CLERK_OCR_PROFILE=deepseek_ocr
# After a trusted match, ordinary Clerk OCR can be preferred. This does not
# override the guarded DeepSeek profile's review-only publication policy.
# CLERK_PREFER_CLERK_OCR=false

# Text/metadata model
CLERK_METADATA_MODEL=qwen2.5:14b

# Clerk lifecycle and decision diagnostics are visible at INFO (the default).
# CLERK_LOG_LEVEL=INFO

# Automation is intentionally opt-in. Leave these unset to control it in the UI.
# CLERK_AUTOMATION_ENABLED=true
# CLERK_AUTOMATION_TAG=clerk

# ntfy notifications are opt-in. Pick a hard-to-guess topic on ntfy.sh, or
# provide the URL and optional access token for a protected/self-hosted topic.
# CLERK_NOTIFICATIONS_ENABLED=true
# CLERK_NTFY_URL=https://ntfy.sh
# CLERK_NTFY_TOPIC=paperless-clerk-random-topic
# CLERK_NTFY_TOKEN=
